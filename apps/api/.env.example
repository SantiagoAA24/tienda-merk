APP_ENV=development
DATABASE_URL=postgresql+psycopg://tienda:tienda@localhost:5432/tienda

# Obligatorio fuera de development/test (mínimo 32 caracteres).
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Opcionales (valores por defecto)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_PERSISTENT_DAYS=30
# REFRESH_SESSION_HOURS=12
# COOKIE_SECURE=true          # por defecto true fuera de development/test
# REFRESH_COOKIE_PATH=/auth

# Solo para el script de datos de ejemplo (uv run python -m app.seed)
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_NAME=Administrador
# SEED_ADMIN_PASSWORD=
